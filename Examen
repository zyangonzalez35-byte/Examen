      "source": [
        "from google.colab import files\n",
        "\n",
        "#Subir archivos a colab\n",
        "print(\"Selecciona el archivo campo.in\")\n",
        "archivos = files.upload()\n",
        "nombre_archivo = next(iter(archivos))\n",
        "\n",
        "puntos = []\n",
        "\n",
        "with open(nombre_archivo, \"r\") as archivo:\n",
        "    for linea in archivo:\n",
        "        datos = linea.split()\n",
        "\n",
        "        if len(datos) < 2:\n",
        "            continue\n",
        "\n",
        "        x, y = map(int, datos)\n",
        "\n",
        "        if x == -1 and y == -1:\n",
        "            break\n",
        "\n",
        "        puntos.append((x, y))\n",
        "#Buscar el triangulo de mas area\n",
        "mayor_area = 0\n",
        "mejor_triangulo = None\n",
        "n = len(puntos)\n",
        "\n",
        "for i in range(n):\n",
        "    for j in range(i + 1, n):\n",
        "        for k in range(j + 1, n):\n",
        "\n",
        "            x1, y1 = puntos[i]\n",
        "            x2, y2 = puntos[j]\n",
        "            x3, y3 = puntos[k]\n",
        "\n",
        "            #Calcular el doble del area\n",
        "            area = abs(\n",
        "                x1 * (y2 - y3) +\n",
        "                x2 * (y3 - y1) +\n",
        "                x3 * (y1 - y2)\n",
        "            )\n",
        "\n",
        "            if area > mayor_area:\n",
        "                mayor_area = area\n",
        "                mejor_triangulo = (\n",
        "                    puntos[i],\n",
        "                    puntos[j],\n",
        "                    puntos[k]\n",
        "                )\n",
        "\n",
        "#Guardar las coordenadas en campo.out\n",
        "if mejor_triangulo is not None:\n",
        "    with open(\"campo.out\", \"w\") as archivo:\n",
        "        for x, y in mejor_triangulo:\n",
        "            archivo.write(f\"{x} {y}\\n\")\n",
        "\n",
        "    print(\"Triangulo de mayor area encontrado:\")\n",
        "    for punto in mejor_triangulo:\n",
        "        print(punto)\n",
        "\n",
        "    print(\"Area:\", mayor_area / 2)\n",
        "    print(\"T: O(n^3)\")\n",
        "    print(\"S: O(n)\")\n",
        "\n",
        "    files.download(\"campo.out\")\n",
        "else:\n",
        "    print(\"No se encontro un triangulo compatible.\")\n"
      ]
    },
